@startuml
@startuml
skinparam dpi 120
skinparam defaultFontName "Microsoft YaHei"
hide circle

class User {
  - userId
  - phone
  - role
}
class Customer {
  - address
}
class Merchant {
  - shopId
}
class Shop {
  - shopName
}
class Dish {
  - name
  - price
  - stock
}
class Order {
  - orderNo
  - amount
  - status
}
class Payment {
  - paymentNo
  - amount
}

User <|-- Customer
User <|-- Merchant
Merchant "1" -- "*" Shop
Shop "1" -- "*" Dish
Customer "1" -- "*" Order
Order "1" -- "1" Payment
@enduml
