@startuml
!pragma layout smetana
skinparam dpi 170
skinparam defaultFontName "Microsoft YaHei"
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam nodesep 30
skinparam ranksep 38
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #1F4E79
  ArrowColor #1F4E79
  FontColor #1F2937
  HeaderBackgroundColor #DCE9F7
  FontSize 15
  AttributeFontSize 12
}
hide circle
title 图 3-1 核心交易类图

class "顾客 Customer" as Customer {
  - customerId: Long
  + placeOrder(cart, address): Order
}
class "收货地址 Address" as Address {
  - contact: String
  - detail: String
  - lng: BigDecimal
  - lat: BigDecimal
}
class "购物车 Cart" as Cart {
  - cartId: Long
  + addItem(spec, qty): void
}
class "购物车项 CartItem" as CartItem {
  - quantity: int
}
class "店铺 Shop" as Shop {
  - shopId: Long
  - deliveryRangeKm: BigDecimal
  - businessStatus: BusinessStatus
}
class "菜品 Dish" as Dish {
  - name: String
  - status: DishStatus
}
class "菜品规格 DishSpec" as DishSpec {
  - price: BigDecimal
  - stock: int
}
class "订单 Order" as Order {
  - orderNo: String
  - requestId: String
  - amount: BigDecimal
  - status: OrderStatus
  - version: int
}
class "订单明细 OrderItem" as OrderItem {
  - nameSnapshot: String
  - unitPrice: BigDecimal
  - quantity: int
}
class "地址快照 AddressSnapshot" as AddressSnapshot {
  - contact: String
  - detail: String
}
class "支付 Payment" as Payment {
  - paymentNo: String
  - status: PaymentStatus
}
class "退款 Refund" as Refund {
  - refundNo: String
  - amount: BigDecimal
  - status: RefundStatus
}

Customer "1" -- "0..*" Address : 维护
Customer "1" -- "1" Cart : 拥有
Cart "1" *-- "1..*" CartItem : 包含
CartItem "*" -- "1" DishSpec : 引用
Customer "1" -- "0..*" Order : 下单
Shop "1" -- "0..*" Dish : 包含
Dish "1" *-- "1..*" DishSpec : 规格
Order "*" -- "1" Shop : 归属
Order "1" *-- "1..*" OrderItem : 包含
OrderItem "*" -- "1" DishSpec : 引用
Order "1" *-- "1" AddressSnapshot : 快照
Order "1" -- "0..1" Payment : 支付
Order "1" -- "0..1" Refund : 售后

note right of Order
  订单号、请求号唯一；
  状态机 + version 乐观锁；
  金额和地址使用下单快照。
end note
@enduml
